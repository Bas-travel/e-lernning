# STAGING — values come from the host's secret store, NOT from this file.
# The API refuses to start unless every rule below holds.
APP_ENV=staging
PORT=8080
DB_DSN=                    # staging database only; must differ from production
JWT_SECRET=                # >= 32 chars: openssl rand -hex 32
CORS_ALLOW_ORIGIN=         # explicit https origin, never *
SEED_DEV=false             # rejected if true
AUTH_DELIVERY=             # real e-mail/SMS provider; "log" is rejected
PAYMENT_MODE=sandbox       # staging never takes real payments
