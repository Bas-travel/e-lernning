# AB Learning - Backend environment example
# Copy to .env and fill values for local development

# Environment
AB_ENV=development
PORT=8080

# Database (MySQL)
# Format: user:pass@tcp(host:port)/dbname?parseTime=true&charset=utf8mb4
DB_DSN=root:password@tcp(127.0.0.1:3306)/ablearning?parseTime=true&charset=utf8mb4

# JWT settings
JWT_SECRET=change_this_to_a_random_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Redis (optional)
REDIS_URL=redis://127.0.0.1:6379/0

# Third-party / provider keys
LLM_PROVIDER=openai
LLM_API_KEY=
STRIPE_API_KEY=
STORAGE_BUCKET=
S3_ENDPOINT=

# Logging
LOG_LEVEL=debug
