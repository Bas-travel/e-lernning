# AB LEARNING API — copy to .env (never commit real values)
APP_ENV=dev                      # dev | staging | production
PORT=8080

# MySQL 8. Migrations in db/migrations run automatically at startup.
DB_DSN=root:password@tcp(127.0.0.1:3306)/ablearning?charset=utf8mb4&loc=UTC&parseTime=true

# REQUIRED when APP_ENV=production (the API refuses to start without it).
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Phase 3 local media storage (Phase 4 moves video to a CDN).
UPLOAD_DIR=./uploads
MAX_VIDEO_MB=500

# Dev only: seeds demo accounts (password "Password123!"). Refused in production.
SEED_DEV=false

CORS_ALLOW_ORIGIN=*              # restrict to your app origin in production
