# Copy to .env and adjust. Real environment variables always win over this
# file (see internal/config/config.go), so in production just set these as
# real env vars and skip the file entirely.

PORT=8080

# Matches docker-compose.yml's mysql service. If running MySQL yourself
# instead, point this at your own instance.
DB_DSN=ab_app:ab_app_pw@tcp(127.0.0.1:3306)/ab_learning?parseTime=true&charset=utf8mb4

# CHANGE THIS before deploying anywhere real.
JWT_SECRET=dev-secret-change-me

# CORS — the Flutter web build's origin during development.
ALLOWED_ORIGIN=*
