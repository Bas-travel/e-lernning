# AB Learning - Flutter frontend environment example
# Place values here or use a script to inject into the app at build time

# App
FLUTTER_ENV=development
APP_NAME=AB Learning
DEFAULT_LOCALE=th

# API
API_BASE_URL=http://localhost:8080/api/v1

# Feature toggles
ANALYTICS_ENABLED=false
SENTRY_DSN=

# Third-party keys
GOOGLE_MAPS_API_KEY=
FIREBASE_API_KEY=
STRIPE_PUBLISHABLE_KEY=

# AI / LLM client (if used from frontend)
LLM_CLIENT_KEY=
